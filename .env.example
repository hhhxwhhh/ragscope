# 复制为 .env 后填写。.env 已被 gitignore，不要提交。
APP_ENV=dev
SECRET_KEY=change-me-to-a-random-string
LOG_LEVEL=INFO

# PostgreSQL（本机 5432 被占用，Docker 映射到 5433）
POSTGRES_USER=ragscope
POSTGRES_PASSWORD=ragscope
POSTGRES_DB=ragscope
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# Redis（本机 6379 被占用，Docker 映射到 6380）
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_PORT=6380
REDIS_DB=0

# 登录限流：每个 email / IP 在窗口内允许的失败次数
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=600

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# 前端跨域
CORS_ORIGINS=http://localhost:5173

# 生产 Compose 的 nginx 端口（docker-compose.prod.yml）
WEB_HOST_PORT=8080

# 日志与可观测性
LOG_FORMAT=text
METRICS_ENABLED=true
# 留空表示 /metrics 不鉴权（集群内抓取）；生产暴露到公网时务必设置
METRICS_TOKEN=
# OpenTelemetry：本地默认关闭；docker-compose.prod.yml 已指向 jaeger:4317
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ragscope-api
OTEL_EXPORTER_ENDPOINT=
OTEL_SAMPLE_RATIO=0.2
PROMETHEUS_HOST_PORT=9090
JAEGER_UI_PORT=16686

# 后台任务：inline（进程内，本地/CI）| celery（独立 worker）
TASK_BACKEND=inline
CELERY_QUEUE=ragscope

# GraphRAG（可选）
GRAPH_RAG_ENABLED=true
GRAPH_EXTRA_TOP_K=3

# 深度研究
DEEP_ENABLED=true
DEEP_MAX_ITERATIONS=2

# 语义缓存（同义问题复用历史答案，仅首轮生效）
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.93
SEMANTIC_CACHE_MAX_ENTRIES=200

# 数据源定期同步
SYNC_ENABLED=true
SYNC_SCHEDULER_INTERVAL_SECONDS=120
SYNC_MAX_ITEMS_PER_RUN=50
# GitHub 连接器：不填则匿名访问（60 次/小时）
GITHUB_TOKEN=

# 每日 token 预算（按知识库，UTC 日；0 = 不限）
DAILY_TOKEN_BUDGET=0

# 答案事实性守护（生成后用 LLM 逐条断言核对检索上下文；失败一律 fail-open）
ANSWER_GROUNDING_ENABLED=true
ANSWER_GROUNDING_THRESHOLD=0.5
ANSWER_GROUNDING_TIMEOUT_SECONDS=8.0
